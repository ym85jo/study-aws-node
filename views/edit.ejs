<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>글 수정</title>
</head>
<body>
  <h1>🛠️ 게시글 수정</h1>
  <form action="/edit/<%= post.id %>" method="POST">
    <div>
      <label>제목: </label><br>
      <input type="text" name="title" value="<%= post.title %>" style="width: 300px;" required>
    </div>
    <br>
    <div>
      <label>내용: </label><br>
      <textarea name="content" rows="6" cols="40" required><%= post.content %></textarea>
    </div>
    <br>
    <button type="submit">수정 완료</button>
    <a href="/post/<%= post.id %>">취소</a>
  </form>
</body>
</html>
